# ─── Database (Postgres 16 + pgvector, EU region in prod) ───
# Runtime role: Row Level Security applies. Used by api, mcp, worker.
DATABASE_URL=postgres://maestro_app:maestro_app@localhost:5432/maestro
# Owner role: migrations, auth lookups, nightly decay. Never used for user-data queries.
DATABASE_ADMIN_URL=postgres://maestro:maestro@localhost:5432/maestro
# pg-boss job queue (defaults to DATABASE_ADMIN_URL). Jobs only carry ids.
# QUEUE_DATABASE_URL=
# Tests (vitest) use a separate database:
# TEST_DATABASE_URL=postgres://maestro_app:maestro_app@localhost:5432/maestro_test
# TEST_DATABASE_ADMIN_URL=postgres://maestro:maestro@localhost:5432/maestro_test

# ─── LLM (extraction & resolve) — always via packages/llm ───
# claude | mistral | openai | mock. Default: claude if ANTHROPIC_API_KEY is set, else mock (offline heuristics).
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# Optional Anthropic inference geography for data residency.
ANTHROPIC_INFERENCE_GEO=
# Override models per tier (defaults: claude-haiku-5-5 / claude-sonnet-5-5, mistral-small-latest / mistral-large-latest).
LLM_MODEL_FAST=
LLM_MODEL_SMART=
MISTRAL_API_KEY=
OPENAI_API_KEY=

# ─── Embeddings ───
# mistral | openai | hash. Default: mistral if MISTRAL_API_KEY is set, else hash (offline, deterministic).
# Changing provider requires re-embedding (rows store embedding_model + embedding_dim).
EMBEDDING_PROVIDER=

# ─── URLs ───
# Public origin of the dashboard. /api, /oauth, /.well-known are proxied to the API from here.
PUBLIC_URL=http://localhost:3000
# Public URL of the MCP endpoint (OAuth protected resource).
MCP_PUBLIC_URL=http://localhost:8788/mcp
# Where Next.js reaches the API server-side.
API_INTERNAL_URL=http://localhost:8787
API_PORT=8787
MCP_PORT=8788

# ─── Auth ───
# Show magic login links in the API response (dev only; ignored when NODE_ENV=production).
AUTH_DEV_LINKS=1

# ─── Worker ───
WORKER_CONCURRENCY=4

# ─── MCP ───
# Shown in the dashboard ("Anslut ett nytt verktyg"); must match MCP_PUBLIC_URL.
NEXT_PUBLIC_MCP_URL=http://localhost:8788/mcp
# Tool calls per grant per minute.
MCP_RATE_LIMIT_PER_MINUTE=120
