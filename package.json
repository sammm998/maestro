{
  "name": "maestro",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@maestro/api --filter=@maestro/worker --filter=@maestro/web --filter=@maestro/mcp",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "db:generate": "pnpm --filter @maestro/db generate",
    "db:migrate": "pnpm --filter @maestro/db migrate",
    "db:seed": "pnpm --filter @maestro/db seed",
    "evals": "pnpm --filter @maestro/evals eval"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "turbo": "^2.11.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
